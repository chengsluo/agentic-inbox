# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Optional. When set, clients may call the API/MCP with `Authorization: Bearer <API_KEY>`
# instead of completing the interactive Cloudflare Access login. Set it with:
#   npx wrangler secret put API_KEY
# Leave unset to keep Access-only access.
# API_KEY=your-long-random-api-key
